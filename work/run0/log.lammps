min_style cg

dump positions all   custom ${Nrestart} frames/step.*.lammpstrj id type x y z vx vy vz
dump positions all   custom 100 frames/step.*.lammpstrj id type x y z vx vy vz

timestep 0.01
fix integrate all      npt temp ${T} ${T} 0.5 iso ${P} ${P} 5
fix integrate all      npt temp 180 ${T} 0.5 iso ${P} ${P} 5
fix integrate all      npt temp 180 180 0.5 iso ${P} ${P} 5
fix integrate all      npt temp 180 180 0.5 iso 1 ${P} 5
fix integrate all      npt temp 180 180 0.5 iso 1 1 5
run 500
